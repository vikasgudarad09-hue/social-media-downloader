{
  "manifest_version": 3,
  "name": "WhatsApp Web Media Extractor",
  "version": "1.0.0",
  "description": "Injects a Download All Media button into WhatsApp Web to scan and download all blob images and videos in chat history.",
  "permissions": [
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Media Extractor"
  }
}
